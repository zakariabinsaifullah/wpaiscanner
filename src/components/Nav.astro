---
import Icon from './Icon.astro';

const links = [
  { label: 'How it works', href: '/#how-it-works' },
  { label: 'The rubric', href: '/#the-rubric' },
  { label: 'Scoring', href: '/#scoring' },
  { label: 'Agent API', href: '/#agent-api' },
  { label: 'Docs', href: '/docs/' },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <div class="nav-left">
      <a class="brand" href="/" aria-label="Crawlwise home">
        <span class="mark"><Icon name="radar" size={14} color="var(--accent)" /></span>
        <span class="wordmark">Crawlwise</span>
      </a>
      <nav class="links" aria-label="Primary">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    <div class="actions">
      <span class="version">v0.1.0</span>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Switch color theme"
        title="Switch color theme"
      >
        <svg
          class="ico ico-sun"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="ico ico-moon"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
      <a class="btn btn--primary btn--sm" href="/#get">Get the plugin</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(150%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 44px;
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
  }

  .mark {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    display: grid;
    place-items: center;
    flex: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--ink);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .links a {
    font-size: 13.5px;
    color: var(--body);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .links a:hover {
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: none;
  }

  .version {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 1.2px;
    color: var(--muted);
  }

  .btn--sm {
    font-size: 13.5px;
    padding: 9px 15px;
    border-radius: 6px;
  }

  /* Matches the brand mark's chip: same size, radius and border. */
  .theme-toggle {
    width: 30px;
    height: 30px;
    flex: none;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s ease, box-shadow 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* Show the icon for the theme you'd switch *to*. */
  .ico-moon {
    display: none;
  }

  :global(html[data-theme='light']) .ico-sun {
    display: none;
  }

  :global(html[data-theme='light']) .ico-moon {
    display: block;
  }

  @media (max-width: 1080px) {
    .links {
      gap: 20px;
    }

    .nav-left {
      gap: 26px;
    }
  }

  @media (max-width: 860px) {
    .links,
    .version {
      display: none;
    }
  }
</style>

