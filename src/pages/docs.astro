<script>
  // Highlight the sidebar entry for whichever section is in view.
  const links = [...document.querySelectorAll('.side-item')];
  const byId = new Map(links.map((a) => [a.getAttribute('href')?.slice(1), a]));
  const sections = [...document.querySelectorAll('.sec[id]')].filter((s) => byId.has(s.id));

  if (sections.length) {
    const seen = new Set();
    const setActive = (id) => {
      links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id)));
        const first = sections.find((s) => seen.has(s.id));
        if (first) setActive(first.id);
      },
      { rootMargin: '-92px 0px -70% 0px', threshold: 0 }
    );

    sections.forEach((s) => observer.observe(s));
    setActive(sections[0].id);
  }

  // Copy the MCP registration snippet.
  document.querySelector('[data-copy]')?.addEventListener('click', async (event) => {
    const btn = event.currentTarget;
    const code = btn.closest('.code-block')?.querySelector('code')?.innerText ?? '';
    const label = btn.querySelector('.copy-label');
    try {
      await navigator.clipboard.writeText(code);
      if (label) {
        label.textContent = 'Copied';
        setTimeout(() => (label.textContent = 'Copy'), 1600);
      }
    } catch {
      /* clipboard blocked — leave the label alone */
    }
  });
</script>
