---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const SITE = Astro.site.href.replace(/\/$/, '');

const sidebar = [
  {
    group: 'Getting started',
    items: [
      { id: 'install', label: 'Installation' },
      { id: 'quickstart', label: 'Quick start' },
    ],
  },
  {
    group: 'Concepts',
    items: [
      { id: 'rubric', label: 'The rubric' },
      { id: 'dimensions', label: 'Dimensions & checks' },
      { id: 'fixes', label: 'Fixes & reversibility' },
    ],
  },
  {
    group: 'Advanced',
    items: [
      { id: 'mcp', label: 'Agent (MCP) server' },
      { id: 'privacy', label: 'Privacy' },
      { id: 'security', label: 'Security' },
    ],
  },
  {
    group: 'Reference',
    items: [
      { id: 'faq', label: 'FAQ' },
      { id: 'changelog', label: 'Changelog' },
    ],
  },
];

// Rendered active so the sidebar is never blank before the observer runs.
const firstSectionId = sidebar[0].items[0].id;

const installSteps = [
  {
    title: 'Upload',
    desc: 'Upload the crawlwise folder to /wp-content/plugins/, or install it through Plugins → Add New.',
  },
  { title: 'Activate', desc: 'Activate the plugin through the Plugins screen.' },
  { title: 'Scan', desc: 'Open Crawlwise in the admin menu and click Scan to grade your site.' },
  {
    title: 'Fix & verify',
    desc: 'Apply a fix from any failing check, then click Verify to confirm the change over a real HTTP request.',
  },
];

const loop = [
  {
    icon: 'scan-line',
    title: 'Scan',
    desc: 'Crawlwise fetches your live URLs and grades five dimensions against the rubric.',
  },
  {
    icon: 'wrench',
    title: 'Fix',
    desc: 'Each failing check offers a one-click fix. Applying one writes plugin settings only — it never edits your theme or rewrites posts.',
  },
  {
    icon: 'badge-check',
    title: 'Verify',
    desc: 'Re-fetch over a real request to confirm the score moved. A scheduled re-scan then watches for drift.',
  },
];

const levels = [
  ['5', 'Agent-Native', '90–100', 'Fully legible and actionable to agents.'],
  ['4', 'Interactive', '75–89', 'Capabilities & APIs are discoverable.'],
  ['3', 'Governed', '55–74', 'Explicit rules for which bots may do what.'],
  ['2', 'Readable', '30–54', 'Content available in machine-friendly form.'],
  ['1', 'Discoverable', '10–29', 'Basic robots & sitemap signals present.'],
  ['0', 'Invisible', '0–9', 'Agents can’t reliably find or read the site.'],
];

const dimensions = [
  {
    name: 'Discoverability',
    pts: '11 pts',
    checks: [
      ['D1', 'robots.txt present & sane', 'Core', '4 pts'],
      ['D2', 'XML sitemap', 'Core', '4 pts'],
      ['D3', 'Link header for discovery', 'Core', '3 pts'],
    ],
  },
  {
    name: 'Content',
    pts: '18 pts',
    checks: [
      ['C1', 'Markdown content negotiation', 'Core', '8 pts'],
      ['C2', '/llms.txt', 'Core', '6 pts'],
      ['C3', 'Structured HTML (headings, landmarks, FAQ, tables)', 'Core', '4 pts'],
    ],
  },
  {
    name: 'Bot Access',
    pts: '15 pts',
    checks: [
      ['B1', 'Content Signals in robots.txt', 'Core', '5 pts'],
      ['B2', 'Explicit AI bot rules', 'Core', '5 pts'],
      ['B3', 'Web Bot Auth key directory', 'Advanced', '5 pts'],
    ],
  },
  {
    name: 'Capabilities',
    pts: '12 pts',
    checks: [
      ['K1', 'API catalog', 'Advanced', '3 pts'],
      ['K2', 'MCP card', 'Advanced', '3 pts'],
      ['K3', 'Agent skills', 'Advanced', '3 pts'],
      ['K4', 'OAuth metadata', 'Advanced', '3 pts'],
    ],
  },
  {
    name: 'Commerce',
    flag: '· Recommended only',
    pts: '10 pts',
    checks: [
      ['M1', 'UCP signals', 'Advanced', '5 pts'],
      ['M2', 'x402 signals', 'Advanced', '5 pts'],
    ],
  },
];

const fixRules = [
  {
    title: 'Settings only',
    desc: 'Every fix writes plugin settings and nothing else. No theme files are edited, and no posts are rewritten.',
  },
  {
    title: 'Genuinely reversible',
    desc: 'Because state lives in settings, “Turn off” restores the exact prior behavior. Applying the C3 fix, for example, derives the meta description at render time rather than rewriting excerpts.',
  },
  {
    title: 'Non-destructive exports',
    desc: 'Static export refuses to overwrite a robots.txt or llms.txt it didn’t create, so a hand-maintained file is never clobbered.',
  },
];

const mcpSteps = [
  {
    title: 'Enable',
    desc: 'Go to Crawlwise → Settings, tick Enable the MCP server, and click Save Changes.',
  },
  {
    title: 'Copy the token',
    desc: 'It is stored hashed and cannot be displayed again — regenerate it if you lose it.',
  },
  {
    title: 'Register with your agent',
    desc: 'Add the endpoint and bearer token to Claude Code, Cursor, or any MCP-capable client:',
  },
];

const securityPoints = [
  'The MCP bearer token is stored as a SHA-256 hash and cannot be recovered.',
  'The token is never included in a settings export.',
  'Failed MCP authentication attempts are rate-limited and rejected.',
  'All dashboard REST routes require the manage_options capability.',
];

const faqs = [
  {
    q: 'Does it conflict with Yoast, Rank Math, or AIOSEO?',
    a: 'No. Crawlwise detects them and defers per feature — you’ll never get duplicate meta descriptions or two JSON-LD graphs.',
  },
  {
    q: 'Why does a check say “couldn’t verify”?',
    a: 'Some hosts block a site from making HTTP requests to itself. Crawlwise reports an informational result rather than guessing a misleading pass or fail.',
  },
  {
    q: 'I enabled static export and nothing happened.',
    a: 'Static export refuses to overwrite an existing robots.txt or llms.txt — your file is never clobbered. Remove or rename it if you want the plugin to manage that path.',
  },
  {
    q: 'What happens when I uninstall?',
    a: 'Uninstalling removes the custom table, all options and every emitted route. Your site is left exactly as Crawlwise found it.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${SITE}/docs/#article`,
      headline: 'Crawlwise Documentation',
      description:
        'Documentation for Crawlwise: installation, the scoring rubric, one-click fixes, the agent-callable MCP server, privacy, security, and FAQ.',
      url: `${SITE}/docs/`,
      inLanguage: 'en',
      image: `${SITE}/og-image.png`,
      author: { '@type': 'Organization', name: 'Crawlwise' },
      publisher: { '@type': 'Organization', name: 'Crawlwise' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Documentation', item: `${SITE}/docs/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Base
  title="Documentation — Crawlwise"
  description="Documentation for Crawlwise: installation, the scoring rubric, one-click fixes, the agent-callable MCP server, privacy, security, and FAQ."
  jsonLd={jsonLd}
>
  <!-- ===================== HERO ===================== -->
  <section class="doc-hero">
    <div class="docwrap hero-row">
      <div class="hero-copy">
        <div class="eyebrow-row">
          <span class="eyebrow">Documentation · v0.1.0</span>
          <span class="rule"></span>
        </div>
        <h1 class="hero-title">Everything you need to run Crawlwise.</h1>
        <p class="hero-intro">
          Install it, understand the rubric, apply reversible fixes, and — if you want — hand the
          whole loop to an agent over MCP.
        </p>
      </div>

      <div class="hero-side">
        <label class="search" for="doc-search">
          <Icon name="search" size={15} color="var(--muted)" />
          <input id="doc-search" type="search" placeholder="Search the docs…" autocomplete="off" />
          <kbd class="kbd">⌘K</kbd>
        </label>
        <span class="mono hero-meta">Last updated Aug 2026 · rubric-v1</span>
      </div>
    </div>
  </section>

  <!-- ===================== BODY ===================== -->
  <div class="docwrap body-row">
    <aside class="sidebar" aria-label="Documentation sections">
      {
        sidebar.map((g) => (
          <div class="side-group">
            <div class="group-head">
              <span class="mono group-label">{g.group}</span>
            </div>
            {g.items.map((i) => (
              <a
                class:list={['side-item', { 'is-active': i.id === firstSectionId }]}
                href={`#${i.id}`}
              >
                <span class="marker" />
                <span class="item-label">{i.label}</span>
              </a>
            ))}
          </div>
        ))
      }
    </aside>

    <div class="doc-content">
      <!-- 01 Installation -->
      <section class="sec" id="install">
        <div class="eyebrow-row">
          <span class="eyebrow">01 · Getting started</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Installation</h2>
        <p class="sec-intro">Crawlwise requires WordPress 6.7+ and PHP 7.4+.</p>

        <ol class="card steps">
          {
            installSteps.map((s, i) => (
              <li class="step">
                <span class="step-no">{i + 1}</span>
                <span class="step-copy">
                  <span class="step-title">{s.title}</span>
                  <span class="step-desc">{s.desc}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="note">
          <Icon name="info" size={15} color="var(--accent)" />
          <p class="note-text">
            Activation creates one custom table (<code>&#123;prefix&#125;_crawlwise_scans</code>) for
            score history and flushes rewrite rules so <code>/llms.txt</code>, <code>*.md</code> and
            <code>.well-known/</code> routes can resolve.
          </p>
        </div>
      </section>

      <!-- 02 Quick start -->
      <section class="sec" id="quickstart">
        <div class="eyebrow-row">
          <span class="eyebrow">02 · Quick start</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">The three-beat loop</h2>
        <p class="sec-intro">
          The core workflow is a three-beat loop you can repeat any time your site changes,
          producing an overall 0–100 score and a readiness level.
        </p>

        <div class="loop-cards">
          {
            loop.map((l) => (
              <div class="card loop-card">
                <div class="loop-head">
                  <Icon name={l.icon} size={15} color="var(--accent)" />
                  <span class="loop-title">{l.title}</span>
                </div>
                <p class="loop-desc">{l.desc}</p>
              </div>
            ))
          }
        </div>

        <p class="sec-outro">
          Because every check is an HTTP request against your own site, the score reflects what a
          crawler actually sees — including cases where a CDN or a physical <code>robots.txt</code> is
          overriding WordPress.
        </p>
      </section>

      <!-- 03 The rubric -->
      <section class="sec" id="rubric">
        <div class="eyebrow-row">
          <span class="eyebrow">03 · Concepts</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">The rubric</h2>
        <p class="sec-intro">
          Scoring is driven entirely by a versioned rubric (<code>rubric-v1</code>) — the single
          source of truth for what gets scored and how much it’s worth. Dimensions roll up to the
          overall score using a weighted average; info-tier results and inapplicable dimensions are
          excluded from the denominator.
        </p>

        <div class="card levels">
          <div class="levels-head">
            <span class="mono c-level">Level</span>
            <span class="mono c-name">Name</span>
            <span class="mono c-score">Score</span>
            <span class="mono c-meaning">Meaning</span>
          </div>
          {
            levels.map(([no, name, score, meaning]) => (
              <div class="level-row">
                <span class="c-level">
                  <span class="level-chip">{no}</span>
                </span>
                <span class="c-name level-name">{name}</span>
                <span class="c-score level-score">{score}</span>
                <span class="c-meaning level-meaning">{meaning}</span>
              </div>
            ))
          }
        </div>

        <p class="sec-outro muted">
          A new rubric version is a new file — the engine stays data-driven, so scoring rules can
          evolve without changing engine code.
        </p>
      </section>

      <!-- 04 Dimensions -->
      <section class="sec" id="dimensions">
        <div class="eyebrow-row">
          <span class="eyebrow">04 · Concepts</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Dimensions &amp; checks</h2>
        <p class="sec-intro">
          Fifteen checks across five dimensions. Each is graded independently over HTTP.
        </p>

        <div class="dim-grid">
          {
            dimensions.map((d) => (
              <div class="card dim">
                <div class="dim-bar">
                  <span class="dim-left">
                    <span class="mono dim-title">{d.name}</span>
                    {d.flag && <span class="mono dim-flag">{d.flag}</span>}
                  </span>
                  <span class="mono dim-pts">{d.pts}</span>
                </div>
                <div class="dim-body">
                  {d.checks.map(([id, name, tier, pts]) => (
                    <div class="check">
                      <span class="check-code">{id}</span>
                      <span class="check-name">{name}</span>
                      <span class="mono tier">{tier}</span>
                      <span class="check-pts">{pts}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 05 Fixes -->
      <section class="sec" id="fixes">
        <div class="eyebrow-row">
          <span class="eyebrow">05 · Concepts</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Fixes &amp; reversibility</h2>
        <p class="sec-intro">
          This is the part that sets Crawlwise apart from a stateless scanner: it doesn’t just tell
          you what’s wrong, it fixes it — safely.
        </p>

        <div class="card rules">
          {
            fixRules.map((r) => (
              <div class="rule-item">
                <Icon name="circle-check" size={15} color="var(--pass)" />
                <span class="rule-copy">
                  <span class="rule-title">{r.title}</span>
                  <span class="rule-desc">{r.desc}</span>
                </span>
              </div>
            ))
          }
        </div>

        <div class="note">
          <Icon name="triangle-alert" size={15} color="var(--accent)" />
          <p class="note-text">
            Enabled static export and nothing happened? It won’t overwrite an existing
            <code>robots.txt</code> / <code>llms.txt</code>. Remove or rename the existing file if you
            want the plugin to manage it.
          </p>
        </div>
      </section>

      <!-- 06 MCP -->
      <section class="sec" id="mcp">
        <div class="eyebrow-row">
          <span class="eyebrow">06 · Advanced</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Agent (MCP) server</h2>
        <p class="sec-intro">
          Crawlwise ships an optional MCP server that exposes <code>scan</code>, <code>fix</code>,
          <code>verify</code> and <code>revert</code> as tools an AI agent can call directly. It is off
          by default and requires a bearer token you generate yourself.
        </p>

        <ol class="card steps">
          {
            mcpSteps.map((s, i) => (
              <li class="step">
                <span class="step-no">{i + 1}</span>
                <span class="step-copy">
                  <span class="step-title">{s.title}</span>
                  <span class="step-desc">{s.desc}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="code-block">
          <div class="code-bar">
            <span class="mono code-title">Terminal</span>
            <button class="copy-btn" type="button" data-copy>
              <Icon name="copy" size={11} color="var(--muted)" />
              <span class="mono copy-label">Copy</span>
            </button>
          </div>
          <pre class="code-body"><code><span class="c-comment"># Register Crawlwise with your agent</span>
<span class="c-cmd">$ claude mcp add --transport http crawlwise \
    https://your-site.com/wp-json/crawlwise/mcp \
    --header "Authorization: Bearer &lt;token&gt;"</span>
<span class="c-ok">✓ connected · tools: scan, fix, verify, revert</span></code></pre>
        </div>

        <p class="sec-outro muted">
          The token is stored as a SHA-256 hash, never in plain text, and is excluded from settings
          exports.
        </p>
      </section>

      <!-- 07 Privacy & security -->
      <section class="sec" id="privacy">
        <div class="eyebrow-row">
          <span class="eyebrow">07 · Advanced</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Privacy &amp; security</h2>

        <div class="ps-row">
          <div class="card ps-card">
            <div class="ps-bar"><span class="mono ps-title">Privacy</span></div>
            <div class="ps-body">
              <p class="ps-text">
                Crawlwise makes HTTP requests to your own site only. It has no telemetry — nothing
                is sent to us or any third party.
              </p>
              <p class="ps-text">
                <code>/llms.txt</code>, the Markdown output and the JSON-LD graph only expose
                already-public content: password-protected, private and draft content is never
                included.
              </p>
            </div>
          </div>

          <div class="card ps-card" id="security">
            <div class="ps-bar"><span class="mono ps-title">Security</span></div>
            <div class="ps-body">
              {
                securityPoints.map((t) => (
                  <div class="sec-item">
                    <Icon name="shield-check" size={13} color="var(--pass)" />
                    <span class="sec-text">{t}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- 08 FAQ -->
      <section class="sec" id="faq">
        <div class="eyebrow-row">
          <span class="eyebrow">08 · Reference</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">FAQ</h2>

        <div class="card faq-list">
          {
            faqs.map((f) => (
              <details class="faq" open>
                <summary class="q-row">
                  <span class="question">{f.q}</span>
                  <span class="chevron">
                    <Icon name="chevron-down" size={14} color="var(--muted)" />
                  </span>
                </summary>
                <p class="answer">{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- Changelog -->
      <section class="sec" id="changelog">
        <div class="eyebrow-row">
          <span class="eyebrow">09 · Reference</span>
          <span class="rule"></span>
        </div>
        <h2 class="sec-title">Changelog</h2>
        <p class="sec-intro">Every release, newest first.</p>

        <div class="card rules">
          <div class="rule-item">
            <Icon name="circle-check" size={15} color="var(--pass)" />
            <span class="rule-copy">
              <span class="rule-title">0.1.0 — initial release</span>
              <span class="rule-desc">
                The scan → fix → verify loop across five dimensions. Password-protected content is
                excluded from Markdown output, <code>/llms.txt</code> and JSON-LD descriptions. The
                MCP bearer token is stored hashed, shown once, and excluded from settings export.
                <code>*.md</code> and <code>.well-known/*</code> URLs return a real 404 when a feature
                is off, and scan history is capped per scope.
              </span>
            </span>
          </div>
        </div>
      </section>

      <!-- Support -->
      <div class="card support">
        <div class="support-copy">
          <Icon name="life-buoy" size={18} color="var(--accent)" />
          <span class="support-text">
            <span class="support-title">Still stuck?</span>
            <span class="support-sub">
              Open a thread on WordPress.org or reach us through wpaiscanner.com — we usually answer
              within a day.
            </span>
          </span>
        </div>
        <div class="support-buttons">
          <a class="btn btn--secondary btn--doc" href="https://wordpress.org/support/" rel="noopener">
            Support forum
          </a>
          <a class="btn btn--primary btn--doc" href="/#get">Contact us</a>
        </div>
      </div>

      <div class="footnote">
        <span>Docs for Crawlwise v0.1.0 · rubric-v1 — corrections welcome via the support forum.</span>
        <span class="mono">wpaiscanner.com/docs</span>
      </div>
    </div>
  </div>
</Base>

<style>
  /* The docs layout runs wider than the marketing pages: 100px gutters. */
  .docwrap {
    width: min(100% - 48px, 1240px);
    margin-inline: auto;
  }

  /* ---------- hero ---------- */
  .doc-hero {
    border-bottom: 1px solid var(--border);
    padding-block: 52px 40px;
  }

  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 700px;
  }

  .hero-title {
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1.14;
    letter-spacing: -0.8px;
  }

  .hero-intro {
    font-size: 13.5px;
    line-height: 22px;
    color: var(--body);
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 320px;
    flex: none;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--border);
    padding: 11px 14px;
    cursor: text;
  }

  .search input {
    flex: 1 1 0;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--ink);
    outline: none;
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    background: var(--surface-2);
    border-radius: 4px;
    padding: 3px 7px;
    flex: none;
  }

  .hero-meta {
    font-size: 10px;
  }

  /* ---------- body ---------- */
  .body-row {
    display: flex;
    align-items: flex-start;
    gap: 48px;
    padding-block: 36px 64px;
  }

  .sidebar {
    width: 220px;
    flex: none;
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .side-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .group-head {
    padding: 0 10px 6px;
  }

  .group-label {
    font-size: 10px;
  }

  .side-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 6px;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .marker {
    width: 3px;
    height: 11px;
    border-radius: 2px;
    background: transparent;
    flex: none;
  }

  .item-label {
    flex: 1 1 0;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--body);
  }

  .side-item:hover .item-label,
  .side-item:focus-visible .item-label {
    color: var(--ink);
  }

  .side-item:hover,
  .side-item:focus-visible {
