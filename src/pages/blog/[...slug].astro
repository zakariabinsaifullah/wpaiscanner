---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/wp.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

const fmt = (d) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

const SITE = Astro.site.href.replace(/\/$/, '');
const url = `${SITE}/blog/${post.slug}/`;
const ogImage = post.image?.src ?? `${SITE}/og-image.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      headline: post.title,
      description: post.description,
      url,
      datePublished: post.pubDate.toISOString().slice(0, 10),
      dateModified: (post.updatedDate ?? post.pubDate).toISOString().slice(0, 10),
      inLanguage: 'en',
      image: ogImage,
      articleSection: post.category,
      ...(post.tags.length ? { keywords: post.tags.join(', ') } : {}),
      author: { '@type': 'Organization', name: 'Crawlwise', url: `${SITE}/` },
      publisher: { '@type': 'Organization', name: 'Crawlwise', url: `${SITE}/` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog/` },
        { '@type': 'ListItem', position: 3, name: post.title, item: url },
      ],
    },
  ],
};
---

<Base
  title={`${post.title} — Crawlwise Blog`}
  description={post.description}
  ogType="article"
  image={ogImage}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class="wrap post-head">
      <a class="back mono" href="/blog/">← All posts</a>
      <span class="tag">{post.category}</span>
      <h1 class="post-title">{post.title}</h1>
      <div class="post-meta mono">
        <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
        <span>·</span><span>{post.readingTime}</span>
        <span>·</span><span>By the Crawlwise team</span>
      </div>
    </div>

    {
      post.image && (
        <div class="wrap">
          <img
            class="hero"
            src={post.image.src}
            alt={post.image.alt}
            width={post.image.width}
            height={post.image.height}
            decoding="async"
          />
        </div>
      )
    }

    <div class="wrap prose">
      <Fragment set:html={post.content} />
    </div>

    <div class="wrap post-foot">
      <a href="/blog/">← All posts</a>
      <a class="dl" href="/#get">
        Download the plugin
        <Icon name="arrow-right" size={13} color="var(--accent)" />
      </a>
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: 56px 100px;
  }

  .post-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    max-width: 760px;
  }

  .back {
    color: var(--muted);
    margin-bottom: 26px;
  }

  .back:hover {
    color: var(--accent);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 4px;
    padding: 3px 8px;
  }

  .post-title {
    margin-top: 16px;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .post-meta {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    width: 100%;
  }

  .prose {
    max-width: 760px;
    /* Breathing room under the meta rule (or the hero) before the body copy. */
    padding-top: 34px;
  }

  .hero {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: 32px;
    background: var(--surface-2);
  }

  .post-foot {
    max-width: 760px;
    clear: both;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 14px;
    font-weight: 600;
  }

  .post-foot a {
    color: var(--accent);
  }

  .dl {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  /* WordPress block output */
  .prose :global(> :first-child) {
    margin-top: 0;
  }

  .prose :global(h2) {
    font-size: 26px;
    letter-spacing: -0.5px;
    margin-top: 44px;
  }

  .prose :global(h3) {
    font-size: 19px;
    letter-spacing: -0.3px;
    margin-top: 30px;
  }

  .prose :global(h4) {
    font-size: 16.5px;
    margin-top: 26px;
  }

  .prose :global(p) {
    margin-top: 18px;
    font-size: 16px;
    line-height: 27px;
    color: var(--body);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-top: 18px;
    padding-left: 22px;
    color: var(--body);
  }

  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li) {
    margin-top: 9px;
    font-size: 16px;
    line-height: 27px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(blockquote) {
    margin: 26px 0;
    padding: 16px 20px;
    background: var(--surface);
    border-left: 2px solid var(--accent);
    border-radius: 0 8px 8px 0;
  }

  .prose :global(blockquote p) {
    margin: 0;
    font-size: 15px;
    line-height: 25px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }

  .prose :global(pre) {
    margin-top: 22px;
    padding: 20px;
    background: var(--surface-3);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    overflow-x: auto;
    font-size: 12.5px;
    line-height: 20px;
  }

  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  /*
    The editor's Code block, dressed to match the panelled snippets on the
    docs page: a labelled bar over a scrollable body. The bar is a pseudo
    element, so the scroll lives on the <code> — a scrolling <pre> would
    slide the bar out of view along with the code.
  */
  .prose :global(.wp-block-code) {
    position: relative;
    margin-top: 26px;
    padding: 32px 0 0;
    /* surface-2 rather than surface-3: in dark mode surface-3 is the page
       colour, which would leave the panel floating on a hairline border. */
    background: var(--surface-2);
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--border);
    overflow: hidden;
  }

  .prose :global(.wp-block-code)::before {
    content: 'Code';
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    height: 32px;
    padding-inline: 16px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prose :global(.wp-block-code code) {
    display: block;
    padding: 14px 16px;
    overflow-x: auto;
    /* Shell snippets break on backslashes; wrapping them would mislead. */
    white-space: pre;
    tab-size: 2;
    font-size: 12px;
    line-height: 20px;
    color: var(--ink);
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .prose :global(.wp-block-code code)::-webkit-scrollbar {
    height: 8px;
  }

  .prose :global(.wp-block-code code)::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 4px;
  }

  .prose :global(.wp-block-preformatted) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  /*
    Blocks that only appear in WordPress-authored content. The editor emits
    its own class names (wp-block-*) with no stylesheet attached here, so
    each block that needs shape gets it explicitly.
  */
  .prose :global(figure),
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .prose :global(figure) {
    margin-top: 30px;
  }

  .prose :global(figure img) {
    display: block;
    border-radius: 8px;
  }

  .prose :global(figcaption) {
    margin-top: 10px;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
    text-align: center;
  }

  .prose :global(.wp-block-image.alignleft),
  .prose :global(.wp-block-image.alignright) {
    max-width: 340px;
  }

  .prose :global(.alignleft) {
    float: left;
    margin: 30px 26px 8px 0;
  }

  .prose :global(.alignright) {
    float: right;
    margin: 30px 0 8px 26px;
  }

  .prose :global(.aligncenter) {
    margin-inline: auto;
  }

  .prose :global(.wp-block-table) {
    margin-top: 26px;
    overflow-x: auto;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border);
    padding: 9px 12px;
    text-align: left;
    line-height: 22px;
  }

  .prose :global(th) {
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .prose :global(.wp-block-embed) {
    margin-top: 30px;
  }

  .prose :global(iframe) {
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .prose :global(.wp-block-button__link) {
    display: inline-block;
    margin-top: 22px;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .prose :global(.screen-reader-text) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .post {
      padding-block: 40px 68px;
    }

    .prose {
      padding-top: 24px;
    }
  }
</style>
